// MIT. Steam Workshop bootstrap for forager-coop @VERSION@ (https://github.com/melogo5/forager-coop).
// Unpacks the co-op DLL and the catch_error.dll bridge (bridge.c) into the Forager profile folder;
// after a restart the bridge loads the co-op DLL. Generated by package.py: the two arrays hold the
// DLL bytes as little-endian u32 words, 10 decimal digits each.
#define Main
  global.fc_stage=0;
  global.fc_at=0;
  global.fc_buffer=-1;
  global.fc_pending=false;
  global.fc_message="Preparing co-op...";
  global.fc_reported=false;
  global.fc_hide_notice=false;
  global.fc_dispatch=undefined;
  // Unique per build: an older co-op DLL that is still loaded is never overwritten.
  global.fc_payload_name="ForagerCoop-@HASH@.dll";
  global.fc_ready_name="ForagerCoop-@HASH@.ready";
  global.fc_bridge=@BRIDGE@;
  global.fc_payload=@PAYLOAD@;
  for(var _fc_boot=0;_fc_boot<1024&&global.fc_stage<8;_fc_boot+=1){FcStep();}

// The mod API only calls whitelisted game scripts; a copy of ScriptCall with its check entry changed also
// reaches SaveAsync and FileExists, which write and test files in the profile folder.
#define FcPrepare
  var _source=ScriptCall;
  var _copy=array_create(array_length_2d(_source,0));
  for(var _row=0;_row<array_height_2d(_source);_row+=1){
    for(var _col=0;_col<array_length_2d(_source,_row);_col+=1){
      array_set(_copy,_row*32000+_col,array_get(_source,_row*32000+_col));
    }
  }
  array_set(_copy,32004,12);
  if(asset_get_index("SaveAsync")<0||asset_get_index("FileExists")<0||asset_get_index("SetDirectory")<0){throw "Unsupported Forager build";}
  global.fc_dispatch=_copy;

#define FcExists(_name)
  return script_execute(global.fc_dispatch,["wrapper","Forager",asset_get_index("FileExists")],_name);

#define FcSave(_name,_buffer)
  script_execute(global.fc_dispatch,["wrapper","Forager",asset_get_index("SaveAsync")],_name,_buffer,asset_get_index("SetDirectory"),[]);

#define FcSaveText(_name,_text)
  var _buffer=buffer_create(string_byte_length(_text),buffer_fixed,1);
  buffer_write(_buffer,buffer_text,_text);
  FcSave(_name,_buffer);

// Decodes 16 chunks per call, then saves; true once the saved file exists.
#define FcDecode(_chunks,_size,_name)
  if(global.fc_pending){return FcExists(_name);}
  if(global.fc_buffer<0){global.fc_buffer=buffer_create(_size,buffer_fixed,1);}
  for(var _work=0;_work<16&&global.fc_at<array_length_1d(_chunks);_work+=1){
    var _text=_chunks[global.fc_at];
    for(var _i=1;_i<=string_length(_text);_i+=10){
      var _word=real(string_copy(_text,_i,10));
      if(_word<0||_word>4294967295){throw "Invalid embedded payload";}
      buffer_write(global.fc_buffer,buffer_u32,_word);
    }
    global.fc_at+=1;
  }
  if(global.fc_at<array_length_1d(_chunks)){return false;}
  if(buffer_tell(global.fc_buffer)!=_size){throw "Invalid payload size";}
  var _buffer=global.fc_buffer;global.fc_buffer=-1;
  global.fc_pending=true;
  FcSave(_name,_buffer);
  return false;

#define OnStep
  FcStep();

// Stages: 0 checks, 1 co-op DLL, 2 bridge, 3 pointer and ready marker, 4 waits for the marker; 8 done, 9 failed.
#define FcStep
  if(global.fc_stage>=8){return;}
  try{
    if(global.fc_stage==0){
      FcPrepare();
      if(FcExists(global.fc_ready_name)){
        global.fc_hide_notice=true;global.fc_stage=8;global.fc_message="Co-op is ready. Use COOP in the main menu.";
        global.fc_payload=[];global.fc_bridge=[];return;
      }
      // FileExists also searches the game folder, where the game's own catch_error.dll always is, so other
      // bridges are recognized by their markers. Their catch_error.dll is loaded and cannot be replaced.
      if(FcExists("ForagerCoopWorkshop-v1-ready.bin")||FcExists("CoopWorkshopBootstrap-owned-v1.bin")){
        global.fc_stage=9;global.fc_payload=[];global.fc_bridge=[];
        global.fc_message="Another co-op Workshop integration is installed. Remove it first (see the mod page).";
        return;
      }
      global.fc_stage=1;
    }
    if(global.fc_stage==1){
      if(!FcExists(global.fc_payload_name)&&!FcDecode(global.fc_payload,@PAYLOAD_SIZE@,global.fc_payload_name)){return;}
      global.fc_payload=[];global.fc_pending=false;global.fc_at=0;global.fc_stage=2;
    }
    if(global.fc_stage==2){
      // The bridge is loaded once installed, so it is written only once; a new bridge needs a new marker name.
      if(!FcExists("ForagerCoop-bridge-2.ready")){
        if(!FcDecode(global.fc_bridge,@BRIDGE_SIZE@,"catch_error.dll")){return;}
        var _mark=buffer_create(1,buffer_fixed,1);buffer_write(_mark,buffer_u8,1);
        FcSave("ForagerCoop-bridge-2.ready",_mark);
      }
      global.fc_bridge=[];global.fc_pending=false;global.fc_stage=3;
    }
    if(global.fc_stage==3){
      FcSaveText("ForagerCoop-current.txt",global.fc_payload_name);
      var _mark=buffer_create(1,buffer_fixed,1);buffer_write(_mark,buffer_u8,1);
      FcSave(global.fc_ready_name,_mark);
      global.fc_stage=4;
    }
    if(global.fc_stage==4){
      if(!FcExists(global.fc_ready_name)){return;}
      global.fc_stage=8;global.fc_message="Ready! Close and reopen Forager from Steam. COOP will appear in the main menu.";
    }
  }catch(_error){
    if(global.fc_buffer>=0){buffer_delete(global.fc_buffer);global.fc_buffer=-1;}
    global.fc_stage=9;global.fc_message="Co-op setup failed. See the mod console.";
    Trace("[ForagerCoop] "+string(_error));
    global.fc_payload=[];global.fc_bridge=[];
  }
  if(global.fc_stage>=8&&!global.fc_reported){global.fc_reported=true;Trace("[ForagerCoop] "+global.fc_message);}

#define OnDrawGUI
  FcStep();
  if(global.fc_hide_notice){exit;}
  draw_set_alpha(0.9);draw_set_color(c_black);
  draw_rectangle(8,8,display_get_gui_width()-8,50,false);
  draw_set_alpha(1);draw_set_color(c_white);draw_set_halign(fa_left);draw_set_valign(fa_top);
  draw_text(16,16,global.fc_message);
